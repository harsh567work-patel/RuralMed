# =============================================================================
# RuralMed .gitignore
# Rules for Clean Deployment: No node_modules, no binaries, no secrets
# =============================================================================

# Dependency Directories
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/

# Production Build Artifacts
dist/
*/dist/
frontend/dist/
backend/dist/
build/
.next/

# Environment Variables & Secrets (Keep .env.example only)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
backend/.env
backend/.env.*
!backend/.env.example

# SQLite Database Binaries & Lock Journals (Auto-created on server boot)
*.db
*.db-journal
*.sqlite
*.sqlite3
database/*.db

# IDE, Editor & OS metadata
.cursor/
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
*.swp
*.swo

# Local deployment tool artifacts
.vercel/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
